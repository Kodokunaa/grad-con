APP_NAME=GradConn
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gradconn
DB_USERNAME=gradconn
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file

QUEUE_CONNECTION=database

DB_QUEUE_TABLE=queue_jobs

MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=GradConn

ADMIN_SEED_NAME="GradConn Administrator"
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@gradconn.local
ADMIN_SEED_PASSWORD=
